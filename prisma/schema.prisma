generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String
  createdAt      DateTime       @default(now())
  titles         Title[]
  ratings        Rating[]
  comments       Comment[]
  watchStatuses  WatchStatus[]
}

model Title {
  id            String        @id @default(cuid())
  name          String
  type          String // "movie" | "series"
  year          Int?
  posterUrl     String?
  synopsis      String?
  createdAt     DateTime      @default(now())
  addedBy       User          @relation(fields: [addedById], references: [id])
  addedById     String
  ratings       Rating[]
  comments      Comment[]
  watchStatuses WatchStatus[]
}

model Rating {
  id        String   @id @default(cuid())
  score     Int // 1 to 10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  titleId   String

  @@unique([userId, titleId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  titleId   String
}

model WatchStatus {
  id        String   @id @default(cuid())
  status    String // "to_watch" | "watched"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  titleId   String

  @@unique([userId, titleId])
}
