# Copie ce fichier en ".env" et remplis les valeurs

# Base de données SQLite locale (ne pas modifier sauf besoin particulier)
DATABASE_URL="file:./dev.db"

# Clé secrète pour signer les sessions - génère la tienne avec :
# openssl rand -base64 32
NEXTAUTH_SECRET="change-moi"

# Code d'invitation demandé à l'inscription, pour que seuls tes amis
# puissent créer un compte. Choisis ce que tu veux.
INVITE_CODE="cinema2026"

# URL de l'app en local (ne pas modifier pour un usage local)
NEXTAUTH_URL="http://localhost:3000"

# Clé API TMDb (optionnelle) : active la recherche/auto-remplissage
# affiche+année+résumé quand tu ajoutes un titre. Gratuite sur
# https://www.themoviedb.org/settings/api ("Clé API (v3 auth)").
# Sans cette variable, l'ajout de titre reste utilisable, juste sans
# les suggestions.
TMDB_API_KEY=""
